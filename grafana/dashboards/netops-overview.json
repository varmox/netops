{
 "uid": "netops-overview",
 "title": "NetOps overview",
 "tags": [
  "netops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Devices",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Device status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Up",
         "color": "green"
        },
        "0.5": {
         "text": "Degraded",
         "color": "orange"
        },
        "0": {
         "text": "Down",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "netops_device_up",
     "legendFormat": "{{device}}",
     "instant": true
    }
   ],
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Ping latency to devices",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "netops_check_latency_ms{check=\"ping\"}",
     "legendFormat": "{{device}}"
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Hours since last good backup",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 26
       },
       {
        "color": "red",
        "value": 48
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - netops_backup_last_success_timestamp) / 3600",
     "legendFormat": "{{device}}",
     "instant": true
    }
   ],
   "id": 4
  },
  {
   "type": "stat",
   "title": "Last backup run",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "OK",
         "color": "green"
        },
        "0": {
         "text": "Failed",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "netops_backup_ok",
     "legendFormat": "{{device}}",
     "instant": true
    }
   ],
   "id": 5
  },
  {
   "type": "row",
   "title": "Internet",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": [],
   "id": 6
  },
  {
   "type": "stat",
   "title": "Internet reachable",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Online",
         "color": "green"
        },
        "0": {
         "text": "Offline",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(probe_success{probe=\"internet\"})",
     "legendFormat": "Internet",
     "instant": true
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Latency to the internet",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 14,
    "w": 18,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_duration_seconds{job=\"internet\"} * 1000",
     "legendFormat": "{{instance}}"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Website response time",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 6
