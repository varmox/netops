#!/usr/sbin/nft -f
# Managed by the NetOps host playbook. Replaces only this table; Docker's tables are left alone.
table inet netops
delete table inet netops

table inet netops {
  set lan4 {
    type ipv4_addr; flags interval;
    elements = { {{ lan_cidrs_v4 | join(', ') }} }
  }
{% if lan_cidrs_v6 %}
  set lan6 {
    type ipv6_addr; flags interval;
    elements = { {{ lan_cidrs_v6 | join(', ') }} }
  }
{% endif %}

  # Traffic to the host itself: SSH and nothing else from outside the LAN.
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state invalid drop
    ct state established,related accept

    # ICMP needed for a working network (PMTU, neighbour discovery), rate-limited
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept
    ip6 nexthdr icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem,
      nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    udp dport 546 ip6 saddr fe80::/10 accept          # DHCPv6 client
    udp dport 68 accept                                # DHCPv4 client (lease renewals)

    ip saddr @lan4 tcp dport 22 ct state new limit rate 10/minute accept
{% if lan_cidrs_v6 %}
    ip6 saddr @lan6 tcp dport 22 ct state new limit rate 10/minute accept
{% endif %}

    limit rate 5/minute log prefix "netops-drop-in: " level info
  }

  # Container ports published by Docker arrive via DNAT and the forward hook, not input. This chain runs
  # just before Docker's (priority filter - 10) and lets only the LAN reach them.
  chain published {
    type filter hook forward priority filter - 10; policy accept;
    ct state established,related accept
    # After DNAT the packet carries the container's port; match the port the client actually asked for.
    ct status dnat meta nfproto ipv4 ct original proto-dst { {{ netops_published_ports | join(', ') }} } ip saddr != @lan4 limit rate 5/minute log prefix "netops-drop-pub: " level info
    ct status dnat meta nfproto ipv4 ct original proto-dst { {{ netops_published_ports | join(', ') }} } ip saddr != @lan4 drop
{% if lan_cidrs_v6 %}
    ct status dnat meta nfproto ipv6 ct original proto-dst { {{ netops_published_ports | join(', ') }} } ip6 saddr != @lan6 drop
{% else %}
    ct status dnat meta nfproto ipv6 ct original proto-dst { {{ netops_published_ports | join(', ') }} } drop
{% endif %}
  }
}
