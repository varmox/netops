# Copy to .env and fill in. .env is git-ignored.

TZ=Europe/Zurich

# Web UI login (https://<host>/login); a session lasts SESSION_HOURS
WEBUI_USER=admin
WEBUI_PASSWORD=change-me
SESSION_HOURS=12

# Names for the self-signed HTTPS certificate (or put your own netops.crt/netops.key into ./certs)
NETOPS_HOSTNAME=netops.lan
NETOPS_IP=192.168.8.10

# Grafana admin (the web UI embeds Grafana read-only for everyone who passed the login above)
GRAFANA_ADMIN_PASSWORD=change-me

# ntfy topic for all alerts (phones subscribe to http://<minipc>:8090/<topic>)
NTFY_TOPIC=netops

# Zyxel web login used for read-only config snapshots
ZYXEL_USER=claude
ZYXEL_PASSWORD=

# Backups: daily at this local time; versions kept per device
BACKUP_TIME=03:15
BACKUP_KEEP=60

# Health checks
CHECK_INTERVAL=60
FAILS_BEFORE_DOWN=2

# Security: links in alerts point here; nightly LAN scan time; optional free NVD API key (faster sync)
NETOPS_PUBLIC_URL=https://192.168.8.10
SECURITY_SCAN_TIME=02:30
NVD_API_KEY=
# true = remediation actions are only logged, nothing changes on the router
SECURITY_DRY_RUN=false

# --- Added features ---------------------------------------------------------
# Honeypot / canary: fake Telnet/SMB/RDP/ADB services; any LAN connection is suspicious
HONEYPOT_ENABLED=true
# Default-password audit (feature 5): OFF by default. true = allow trying factory logins against YOUR LAN
CREDCHECK_ENABLED=false
# DNS filtering (optional `dns` profile): AdGuard Home admin login, set after its first-run setup
ADGUARD_URL=http://adguard:3000
ADGUARD_USER=
ADGUARD_PASSWORD=
# Weekly report: day (0 = Monday) and local time it is pushed to ntfy
REPORT_DAY=0
REPORT_TIME=08:00
